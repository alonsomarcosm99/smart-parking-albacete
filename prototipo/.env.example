# Configuracion del prototipo Smart Parking Albacete
# Copia este fichero a .env y rellena los valores

# Region y prefijos AWS (no se requiere cuenta porque se usa el perfil por defecto)
AWS_REGION=us-east-1
RESOURCE_PREFIX=smart-parking-albacete

# Endpoint de AWS IoT Core (se autodescubre con boto3 si se deja vacio)
IOT_ENDPOINT=

# URL base de la API REST desplegada (se rellena tras 04_setup_api_gateway.py)
API_BASE_URL=

# Numero de plazas a simular y duracion (segundos) para el fleet_runner
SIM_NUM_SPOTS=40
SIM_DURATION=0
SIM_HEARTBEAT_SECONDS=60
SIM_EVENT_RATE_PER_MINUTE=4
